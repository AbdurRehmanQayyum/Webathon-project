<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- The modules section is locked on many servers, so Setup.ps1 handles the WebDAV module -->
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- Startup errors are written to the logs folder -->
      <aspNetCore processPath=".\CampusConnect.Api.exe" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <!-- Video uploads need more than the 30 MB IIS default -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="110100480" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
